#!/bin/bash
# Print the banner: pink cats, cyan->blue wordmark. Plain text when NO_COLOR is set or piped.
# Line numbers match kali/motd: 2-4 mascot, 6-11 wordmark, 13-14 title, 16-20 help box.
# The Dockerfile runs this with COPYCAT_FORCE_COLOR=1 to bake the colored /etc/motd.
. /usr/local/lib/copycat/color.sh
src=/usr/local/share/copycat/motd.txt
if [ -z "$C_RST" ]; then cat "$src"; exit; fi
awk '
  NR>=2  && NR<=4  { printf "\033[38;5;213m%s\033[0m\n", $0; next }
  NR>=6  && NR<=11 { split("51 45 39 33 27 21", c, " "); printf "\033[38;5;%sm%s\033[0m\n", c[NR-5], $0; next }
  NR>=13 && NR<=14 { printf "\033[1m%s\033[0m\n", $0; next }
  NR>=16           { printf "\033[2m%s\033[0m\n", $0; next }
  { print }
' "$src"
