#!/bin/bash
. /usr/local/lib/copycat/color.sh
# shellcheck disable=SC2088  # literal ~ is intentional in the message
cd "$HOME/labs" 2>/dev/null || { echo '~/labs is gone. Time to reset!'; exit 1; }
done_file="$HOME/.copycat-progress"
printf '%s  /\\_/\\%s   %sLABS%s\n' "$C_PINK" "$C_RST" "$C_BOLD" "$C_RST"
printf '%s ( o.o )%s  %s[x] = marked done with copycat-done NN%s\n' "$C_PINK" "$C_RST" "$C_DIM" "$C_RST"
printf '%s  > ^ <%s\n\n' "$C_PINK" "$C_RST"
db="$HOME/.copycat/progress.db"
for d in */; do
  d=${d%/}; n=${d%%-*}; t=${d#*-}
  # Graded labs (copycat-check) show their best score; ungraded ones use copycat-done.
  tag=''; best=''
  if [ -d "/usr/local/lib/copycat/grading/$d" ]; then
    case $n in *[!0-9]*|'') ;; *)
      [ -f "$db" ] && best=$(sqlite3 "$db" "SELECT MAX(score) FROM results WHERE lab='$n'" 2>/dev/null) ;;
    esac
    tag="  ${C_DIM}[graded${best:+: $best/100}]${C_RST}"
  fi
  if [ "$best" = 100 ] || grep -qx "$d" "$done_file" 2>/dev/null; then
    printf '[%sx%s] %s%s  %s%s%s\n' "$C_GRN" "$C_RST" "$C_GRN" "$n" "$t" "$C_RST" "$tag"
  else
    printf '[ ] %s%s%s  %s%s\n' "$C_CYAN" "$n" "$C_RST" "$t" "$tag"
  fi
done
lab_counts "$done_file"
printf '\n%s %s/%s done\n' "$(draw_bar "$LAB_DONE" "$LAB_TOTAL")" "$LAB_DONE" "$LAB_TOTAL"
if [ "$LAB_TOTAL" -gt 0 ] && [ "$LAB_DONE" -eq "$LAB_TOTAL" ]; then
  printf '%s  /\\_/\\\n ( ^.^ )  every lab done. the cat is proud.\n  > ^ <%s\n' "$C_PINK" "$C_RST"
else
  echo "Open one:  cat ~/labs/01-core/README.md"
  echo "Graded labs:  copycat-setup NN, fix it, then copycat-check NN"
fi
